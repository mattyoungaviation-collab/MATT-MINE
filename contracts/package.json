{
  "name": "@matt-mine/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Non-upgradeable MATT Mine Pass, paid-run, swap, and reward contracts for Ronin.",
  "scripts": {
    "compile": "hardhat compile --build-profile production",
    "test": "hardhat test",
    "validate:ronin": "hardhat run scripts/validate-mainnet-config.js --network roninReadOnly",
    "check-deployment:ronin": "hardhat run scripts/check-mainnet-deployment.js --network roninReadOnly",
    "check-deployer:ronin": "hardhat run scripts/check-deployer.js --network ronin",
    "deploy:ronin": "hardhat run --build-profile production scripts/deploy-mainnet.js --network ronin",
    "verify:ronin": "hardhat run --build-profile production scripts/verify-mainnet.js --network roninReadOnly",
    "check-arena-deployer:ronin": "hardhat run --build-profile production scripts/check-arena-deployer.js --network ronin",
    "deploy-arena:ronin": "hardhat run --build-profile production scripts/deploy-arena-mainnet.js --network ronin",
    "check-arena-deployment:ronin": "hardhat run --build-profile production scripts/check-arena-mainnet-deployment.js --network roninReadOnly",
    "verify-arena:ronin": "hardhat run --build-profile production scripts/verify-arena-mainnet.js --network roninReadOnly",
    "validate-nft:ronin": "hardhat run scripts/validate-nft-mainnet-config.js --network roninReadOnly",
    "check-nft-deployer:ronin": "hardhat run --build-profile production scripts/check-nft-mainnet-deployer.js --network ronin",
    "deploy-nft:ronin": "hardhat run --build-profile production scripts/deploy-nft-mainnet.js --network ronin",
    "validate-nft:saigon": "hardhat run scripts/validate-nft-saigon-config.js --network saigonReadOnly",
    "deploy-nft:saigon": "hardhat run --build-profile production scripts/deploy-nft-saigon.js --network saigon",
    "configure-nft:saigon": "hardhat run --build-profile production scripts/configure-nft-saigon.js --network saigon",
    "check-nft:saigon": "hardhat run --build-profile production scripts/check-nft-saigon.js --network saigonReadOnly",
    "verify-nft:saigon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-nft-saigon.ps1",
    "bootstrap-nft-rehearsal:saigon": "hardhat run --build-profile production scripts/bootstrap-nft-saigon-rehearsal.js --network saigon",
    "check-nft-rehearsal:saigon": "hardhat run --build-profile production scripts/check-nft-saigon-rehearsal.js --network saigonReadOnly",
    "activate-chest-keeper:saigon": "hardhat run --build-profile production scripts/activate-saigon-chest-keeper.js --network saigon",
    "validate-nft-v2:saigon": "hardhat run scripts/validate-nft-v2-saigon-config.js --network saigonReadOnly",
    "deploy-nft-v2:saigon": "hardhat run --build-profile production scripts/deploy-nft-v2-saigon.js --network saigon",
    "check-nft-v2:saigon": "hardhat run --build-profile production scripts/check-nft-v2-saigon.js --network saigonReadOnly",
    "audit-nft-v2": "node scripts/audit-nft-v2-source.js",
    "validate-nft-v2:ronin": "hardhat run scripts/validate-nft-v2-mainnet-config.js --network roninReadOnly",
    "check-nft-v2-deployer:ronin": "hardhat run --build-profile production scripts/check-nft-v2-mainnet-deployer.js --network roninNftV2",
    "deploy-nft-v2:ronin": "hardhat run --build-profile production scripts/deploy-nft-v2-mainnet.js --network roninNftV2",
    "check-nft-v2:ronin": "hardhat run --build-profile production scripts/check-nft-v2-mainnet.js --network roninReadOnly",
    "verify-nft-v2:ronin": "hardhat run --build-profile production scripts/verify-nft-v2-mainnet.js --network roninReadOnly",
    "check-nft-v2-inventory:ronin": "hardhat run --build-profile production scripts/check-nft-v2-mainnet-inventory.js --network roninReadOnly",
    "premint-nft-v2-inventory:ronin": "hardhat run --build-profile production scripts/premint-nft-v2-mainnet-inventory.js --network roninNftV2",
    "check-nft-v2-activation:ronin": "hardhat run --build-profile production scripts/check-nft-v2-mainnet-activation.js --network roninNftV2",
    "activate-nft-v2:ronin": "hardhat run --build-profile production scripts/activate-nft-v2-mainnet.js --network roninNftV2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@nomicfoundation/hardhat-keystore": "3.0.12",
    "@nomicfoundation/hardhat-network-helpers": "3.0.11",
    "@nomicfoundation/hardhat-node-test-runner": "3.0.17",
    "@nomicfoundation/hardhat-verify": "3.0.21",
    "@openzeppelin/merkle-tree": "1.0.8",
    "ethers": "6.17.0",
    "hardhat": "3.12.0",
    "solc": "0.8.28"
  }
}
