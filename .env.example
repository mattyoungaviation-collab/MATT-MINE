PORT=4173
MATT_MINE_PUBLIC_ORIGIN=http://localhost:4173
MATT_MINE_DATA_FILE=data/matt-mine-store.json
# Production uses PostgreSQL. Local development falls back to the JSON data file above.
# DATABASE_URL=postgresql://user:password@host:5432/matt_mine
MATT_MINE_DATABASE_SSL=false
MATT_MINE_DATABASE_SSL_REJECT_UNAUTHORIZED=false
MATT_MINE_DATABASE_POOL_SIZE=10
# Leave unset until a private admin service is configured.
# MATT_MINE_ADMIN_KEY=

# DANGER: when true, the UI can prepare real Ronin Mainnet Pass and paid-run
# transactions. Players must still explicitly approve every transaction.
MATT_MINE_MAINNET_TRANSACTIONS_ENABLED=false
MATT_MINE_PAYMENT_CONFIRMATIONS=3
# RONIN_RPC_URL=https://api.roninchain.com/rpc

# Daily Arena requires the exact deployed contract and independent private
# receipt/seed secrets. Keep this false outside reviewed production releases.
MATT_MINE_ARENA_CONTRACT_ADDRESS=0x506f969279F8264fd629BBB0Df861Ab91343b12C
MATT_MINE_ARENA_EXPECTED_CONTRACT_ADDRESS=0x506f969279F8264fd629BBB0Df861Ab91343b12C
MATT_MINE_ARENA_RUNTIME_CODE_HASH=0xbe675f45747d267318291cad7295374ad5c65fa06063fe3b8cc111b8fa27453a
# MATT_MINE_ARENA_RECEIPT_SECRET=
# v2.0 uses fixed-step input-only replay. The contract pause remains the final
# independent control over whether players can transfer MATT into the Arena.
MATT_MINE_ARENA_LIVE=false
# Optional independent deterministic seed secret; defaults to receipt secret.
# MATT_MINE_ARENA_SEED_SECRET=
# Production controller values. Startup verifies the token, runtime bytecode,
# Safe roles and emergency pauser role before serving.
MATT_MINE_ARENA_MATT_ADDRESS=0xa5450417BDCa0BDfB058ffE41205400FfDA1174d
MATT_MINE_ARENA_SAFE_ADDRESS=0xBacE355D23d378a6E1adD986E53a18Dd12E6EeAc
MATT_MINE_ARENA_PAUSER_ADDRESS=0x57Dc8DB3a263506a0344eC15B4C623EBb8E589F4
MATT_MINE_ARENA_DEPLOYER_ADDRESS=0xeED0491B506C78EA7fD10988B1E98A3C88e1C630
