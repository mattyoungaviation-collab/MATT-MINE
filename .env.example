PORT=4173
MATT_MINE_PUBLIC_ORIGIN=http://localhost:4173
# Render places the verified client address first in X-Forwarded-For. Keep
# this blank anywhere the Node server is directly reachable from the internet.
MATT_MINE_TRUST_PROXY=
# Public Reown project ID used by WalletConnect in ordinary mobile browsers.
# Add the production site origin to this project's Reown allowlist.
# VITE_WALLETCONNECT_PROJECT_ID=00000000000000000000000000000000
MATT_MINE_DATA_FILE=data/matt-mine-store.json
# Production uses PostgreSQL. Local development falls back to the JSON data file above.
# DATABASE_URL=postgresql://user:password@host:5432/matt_mine
MATT_MINE_DATABASE_SSL=false
MATT_MINE_DATABASE_SSL_REJECT_UNAUTHORIZED=false
# PostgreSQL also reserves one dedicated advisory-lock connection beyond this request-pool size.
MATT_MINE_DATABASE_POOL_SIZE=10
# Leave unset until a private admin service is configured.
# MATT_MINE_ADMIN_KEY=

# DANGER: when true, the UI can prepare real Ronin Mainnet Pass and paid-run
# transactions. Players must still explicitly approve every transaction.
MATT_MINE_MAINNET_TRANSACTIONS_ENABLED=false
MATT_MINE_PAYMENT_CONFIRMATIONS=3
# RONIN_RPC_URL=https://api.roninchain.com/rpc

# Daily Arena requires the exact deployed contract and independent private
# receipt/seed secrets. Keep this false outside reviewed production releases.
MATT_MINE_ARENA_CONTRACT_ADDRESS=0x506f969279F8264fd629BBB0Df861Ab91343b12C
MATT_MINE_ARENA_EXPECTED_CONTRACT_ADDRESS=0x506f969279F8264fd629BBB0Df861Ab91343b12C
MATT_MINE_ARENA_RUNTIME_CODE_HASH=0xbe675f45747d267318291cad7295374ad5c65fa06063fe3b8cc111b8fa27453a
# MATT_MINE_ARENA_RECEIPT_SECRET=
# v2.0 uses fixed-step input-only replay. The contract pause remains the final
# independent control over whether players can transfer MATT into the Arena.
# The same server replay secret signs every Endless per-phase input chain.
# Keep it private and stable across all production web instances.
# MATT_MINE_COMPETITIVE_REPLAY_SECRET=
MATT_MINE_ARENA_LIVE=false
# Optional independent deterministic seed secret; defaults to receipt secret.
# MATT_MINE_ARENA_SEED_SECRET=
# Production controller values. Startup verifies the token, runtime bytecode,
# Safe roles and emergency pauser role before serving.
MATT_MINE_ARENA_MATT_ADDRESS=0xa5450417BDCa0BDfB058ffE41205400FfDA1174d
MATT_MINE_ARENA_SAFE_ADDRESS=0xBacE355D23d378a6E1adD986E53a18Dd12E6EeAc
MATT_MINE_ARENA_PAUSER_ADDRESS=0x57Dc8DB3a263506a0344eC15B4C623EBb8E589F4
MATT_MINE_ARENA_DEPLOYER_ADDRESS=0xeED0491B506C78EA7fD10988B1E98A3C88e1C630

# NFT V2 production addresses below are the activated Ronin Mainnet release.
# Keep the feature flags false locally unless the dedicated operator/signer
# secrets are configured. Production RPC reads should use the first Alchemy
# URL in RONIN_RPC_URLS or an explicit MATT_MINE_NFT_RPC_URL.
MATT_MINE_NFT_ENABLED=false
MATT_MINE_NFT_CONTRACT_VERSION=2
MATT_MINE_NFT_PUBLIC_BASE_URL=https://mattmine.com
MATT_MINE_NFT_CHAIN_ID=2020
# MATT_MINE_NFT_RPC_URL=https://ronin-mainnet.g.alchemy.com/v2/REPLACE_ME
MATT_MINE_NFT_ADMIN_ADDRESS=0xF79913cB83Cc9CABD95D0ba9250103fbb939f984
MATT_MINE_NFT_VAULT_ADDRESS=0xBacE355D23d378a6E1adD986E53a18Dd12E6EeAc
MATT_MINE_NFT_GAME_OPERATOR_ADDRESS=0x112C8a89bfAb3f19D7ceADf7433Fd8D253cFe4D3
MATT_MINE_NFT_REWARD_SIGNER_ADDRESS=0x61FC35192964Fa4b50D915261419e9D2Ba369708
# Store signer private keys only in the production secret manager. Never commit
# them to this file or any JSON configuration.
# Both dedicated keys must match their on-chain roles. Never store the 0xF799
# root-admin key on the game server.
MATT_MINE_NFT_GAMEPLAY_ENABLED=false
# MATT_MINE_NFT_GAME_OPERATOR_PRIVATE_KEY=
# MATT_MINE_NFT_REWARD_SIGNER_PRIVATE_KEY=
# Enable only after activation grants CONFIG_ROLE to the dedicated operator.
MATT_MINE_NFT_ADMIN_CONTROLS_ENABLED=false
MATT_MINE_NFT_CONFIG_OPERATOR_ADDRESS=0x112C8a89bfAb3f19D7ceADf7433Fd8D253cFe4D3
# MATT_MINE_NFT_CONFIG_OPERATOR_PRIVATE_KEY=
MATT_MINE_NFT_MINER_ADDRESS=0xBbaBE35B943E3Ba911B53C2b39447cF181fE565A
MATT_MINE_NFT_MINER_DEPLOYMENT_BLOCK=59628599
MATT_MINE_NFT_EQUIPMENT_ADDRESS=0x415cF1DeA47f3d4BAb830F78B82e12D6EeceD612
MATT_MINE_NFT_EQUIPMENT_DEPLOYMENT_BLOCK=59628601
# MATT_MINE_NFT_EQUIPMENT_INDEX_CHUNK_SIZE=1000
# MATT_MINE_NFT_EQUIPMENT_INDEX_REFRESH_MS=5000
# MATT_MINE_NFT_EQUIPMENT_INDEX_CONFIRMATIONS=12
# MATT_MINE_NFT_EQUIPMENT_INDEX_MAX_CHUNKS=25
# MATT_MINE_NFT_EQUIPMENT_INDEX_STARTUP_WAIT_MS=1500
# MATT_MINE_NFT_EQUIPMENT_SNAPSHOT_TTL_MS=120000
MATT_MINE_NFT_LOADOUT_ADDRESS=0xb88C219C792cFa07749E0E5D939DbbbF1E62C7b5
MATT_MINE_NFT_CHEST_ADDRESS=0x693525e7fD76949834cad56d67D469bAAd6687F6
MATT_MINE_NFT_SETTLEMENT_ADDRESS=0x21BEe81AdC4c87e3Ea4686DD8a38a64c8Ea5b95c
MATT_MINE_NFT_CRYSTAL_BANK_ADDRESS=0x8C640Cd91Ea6616cDD07B8323492E76e5c9ffE78
MATT_MINE_NFT_PASSIVE_REWARDS_ADDRESS=0xC5cf71e8000017e099fb39b24149544e1F40b0E0
MATT_MINE_NFT_CHEST_RANDOMNESS_ADDRESS=0x74746f7853e84302255B49421A6A3AF5808c8AA6
MATT_MINE_NFT_PASSIVE_RANDOMNESS_ADDRESS=0x652eD370383a7B5bf3c1c19e2145780bcb9A92F8
MATT_MINE_OPERATIONS_STAGE=public
MATT_MINE_OPERATIONS_CACHE_MS=20000
# The server exposes the current operations report only to authenticated Admin.
# A scheduler, alert destination, and on-call route must be configured externally.
MATT_MINE_NFT_MAP_VERSIONS_JSON={"arena":"0x5fa5b85dfd9794c50d1de87c83b8cc2b28e4c454c4d64ce7280876984fd526f0","paid":"0x4d86497b3e3385412a206bebed747aa621db1d38766608d19e69f2eb7185385c"}

# Endless settlement is a separate compact V2 module. Keep it disabled until
# its deployment manifest is verified, the approved economy version is mapped,
# and the contract has been explicitly activated. Economy values remain
# adjustable through versioned Admin config plus a matching on-chain version.
MATT_MINE_ENDLESS_SETTLEMENT_ENABLED=false
# MATT_MINE_ENDLESS_SETTLEMENT_ADDRESS=
# MATT_MINE_ENDLESS_DEPLOYMENT_BLOCK=
# MATT_MINE_ENDLESS_VERSION_IDS_JSON={"endless-conservative-v1":"0x..."}
# Ronin receipt/event reconciliation is bounded and adjustable. Defaults: six
# reads, 1.5 seconds apart (about 7.5 seconds after the first read).
# MATT_MINE_ENDLESS_RECONCILIATION_ATTEMPTS=6
# MATT_MINE_ENDLESS_RECONCILIATION_DELAY_MS=1500
# Optional minimum operator gas balance; default is 0.02 RON.
# MATT_MINE_NFT_OPERATOR_MINIMUM_BALANCE_WEI=20000000000000000

# Paid Endless entry is independently fail-closed. The price and paid/free
# switch are versioned Admin settings. The server always pins Ronin Mainnet,
# the trusted MATT token, 18 decimals, and the approved Treasury Safe recipient.
# It creates a run only after the exact ERC-20 transfer is confirmed and unused.
MATT_MINE_ENDLESS_PAYMENTS_ENABLED=false
# Adjustable independently from other payment flows; defaults to the shared value.
# MATT_MINE_ENDLESS_PAYMENT_CONFIRMATIONS=3

# Paid competition stays closed unless the approved rules are configured.
MATT_MINE_ELIGIBILITY_COUNSEL_APPROVED=false
# MATT_MINE_ELIGIBILITY_RULES_VERSION=
# MATT_MINE_ELIGIBILITY_RULES_SHA256=
# MATT_MINE_ELIGIBILITY_RULES_URL=
# Set to arena to replace the development wallet allowlist with one-time,
# per-wallet age/location/rules/prohibited-activity acknowledgement.
# MATT_MINE_PUBLIC_PAID_MODES=arena
# Optional dedicated secret; defaults to MATT_MINE_ARENA_RECEIPT_SECRET.
# MATT_MINE_ELIGIBILITY_RECEIPT_SECRET=
# MATT_MINE_ELIGIBLE_PAID_WALLETS=
